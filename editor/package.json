{
  "name": "rin-language",
  "displayName": "Rin",
  "description": "Rin syntax highlighting, language server, completion, diagnostics and run command.",
  "version": "0.1.1",
  "publisher": "rin-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:rin",
    "onCommand:rin.run"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting is available. Trust the workspace to start the language server and run the configured compiler.",
      "restrictedConfigurations": [
        "rin.executable"
      ]
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "rin",
        "aliases": [
          "Rin",
          "rin"
        ],
        "extensions": [
          ".rin"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rin",
        "scopeName": "source.rin",
        "path": "./syntaxes/rin.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "label",
        "superType": "variable",
        "description": "Rin verification label"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "rin",
        "scopes": {
          "variable.readonly": [
            "variable.other.constant.rin"
          ],
          "parameter": [
            "variable.parameter.rin"
          ],
          "type": [
            "entity.name.type.rin"
          ],
          "function": [
            "entity.name.function.rin"
          ],
          "namespace": [
            "entity.name.namespace.rin"
          ],
          "label": [
            "entity.name.label.rin"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "rin",
        "path": "./snippets/rin.json"
      }
    ],
    "commands": [
      {
        "command": "rin.run",
        "title": "Run Rin File",
        "category": "Rin",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rin.run",
          "when": "resourceLangId == rin && isWorkspaceTrusted",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Rin",
      "properties": {
        "rin.executable": {
          "type": "string",
          "default": "rin",
          "scope": "window",
          "description": "Rin executable on PATH, an absolute path, or a path relative to the first workspace folder. No shell arguments."
        },
        "rin.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Check unsaved Rin text with the configured compiler (--check --stdin)."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  }
}
