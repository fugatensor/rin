{
  "name": "suka-language",
  "displayName": "Suka",
  "description": "Suka syntax highlighting, language server, completion, diagnostics and run command.",
  "version": "0.1.1",
  "publisher": "suka-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:suka",
    "onCommand:suka.run"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting is available. Trust the workspace to start the language server and run the configured compiler.",
      "restrictedConfigurations": [
        "suka.executable"
      ]
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "suka",
        "aliases": [
          "Suka",
          "suka"
        ],
        "extensions": [
          ".suka"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "suka",
        "scopeName": "source.suka",
        "path": "./syntaxes/suka.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "label",
        "superType": "variable",
        "description": "Suka verification label"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "suka",
        "scopes": {
          "variable.readonly": [
            "variable.other.constant.suka"
          ],
          "parameter": [
            "variable.parameter.suka"
          ],
          "type": [
            "entity.name.type.suka"
          ],
          "function": [
            "entity.name.function.suka"
          ],
          "namespace": [
            "entity.name.namespace.suka"
          ],
          "label": [
            "entity.name.label.suka"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "suka",
        "path": "./snippets/suka.json"
      }
    ],
    "commands": [
      {
        "command": "suka.run",
        "title": "Run Suka File",
        "category": "Suka",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "suka.run",
          "when": "resourceLangId == suka && isWorkspaceTrusted",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Suka",
      "properties": {
        "suka.executable": {
          "type": "string",
          "default": "suka",
          "scope": "window",
          "description": "Suka executable on PATH, an absolute path, or a path relative to the first workspace folder. No shell arguments."
        },
        "suka.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Check unsaved Suka text with the configured compiler (--check --stdin)."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  }
}
