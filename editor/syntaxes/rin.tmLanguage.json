{
  "name": "Rin",
  "scopeName": "source.rin",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "name": "string.quoted.double.rin",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.rin",
          "match": "\\\\."
        }
      ]
    },
    {
      "match": "^\\s*(import)\\s+((?:(?!=>|->)[^\\s:,()=|&#\"<>])+)",
      "captures": {
        "1": {
          "name": "keyword.control.import.rin"
        },
        "2": {
          "name": "entity.name.namespace.rin"
        }
      }
    },
    {
      "match": "^\\s*(verify)\\s+((?:(?!=>|->)[^\\s:,()=|&#\"<>])+)\\s*(=)",
      "captures": {
        "1": {
          "name": "keyword.control.verify.rin"
        },
        "2": {
          "name": "entity.name.label.rin"
        },
        "3": {
          "name": "keyword.operator.assignment.rin"
        }
      }
    },
    {
      "name": "meta.declaration.quantifier.rin",
      "begin": "(?<![^\\s:,()=|&#\"<>])(all|exists)(?=\\s+(?:(?!=>|->)[^\\s:,()=|&#\"<>])+)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.quantifier.rin"
        }
      },
      "end": "=>|$",
      "endCaptures": {
        "0": {
          "name": "keyword.operator.quantifier.rin"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#type"
        },
        {
          "name": "variable.parameter.rin",
          "match": "(?:(?!=>|->)[^\\s:,()=|&#\"<>])+"
        },
        {
          "name": "punctuation.separator.rin",
          "match": ","
        }
      ]
    },
    {
      "include": "#type"
    },
    {
      "name": "entity.name.function.rin",
      "match": "(?:(?!=>|->)[^\\s:,()=|&#\"<>])+(?=\\s*\\()"
    },
    {
      "include": "#number"
    },
    {
      "name": "keyword.operator.rin",
      "match": "=>|->|[=&]"
    },
    {
      "name": "punctuation.separator.rin",
      "match": "[,:]"
    },
    {
      "name": "punctuation.section.group.rin",
      "match": "[()]"
    },
    {
      "name": "variable.other.constant.rin",
      "match": "(?:(?!=>|->)[^\\s:,()=|&#\"<>])+"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.rin",
      "begin": "#",
      "end": "$"
    },
    "type": {
      "match": "(:)\\s*((?:(?!=>|->)[^\\s:,()=|&#\"<>])+)",
      "captures": {
        "1": {
          "name": "punctuation.separator.type.rin"
        },
        "2": {
          "name": "entity.name.type.rin"
        }
      }
    },
    "number": {
      "name": "constant.numeric.rin",
      "match": "(?<![^\\s:,()=|&#\"<>])[0-9]+(?![^\\s:,()=|&#\"<>])"
    }
  }
}
