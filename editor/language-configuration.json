{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [{ "open": "(", "close": ")" }, { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }],
  "surroundingPairs": [["(", ")"], ["\"", "\""]],
  "wordPattern": "[^\\s:,()=|#\"<>]+",
  "indentationRules": { "increaseIndentPattern": "^\\s*all\\b.*=>\\s*(?:#.*)?$" }
}
