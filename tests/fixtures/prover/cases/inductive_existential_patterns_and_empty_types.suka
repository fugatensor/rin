
type nat = 0 | succ(nat)
type pair = pair(nat, nat)
type empty = loop(empty)
verify SUCCESSOR = exists n => succ(n) : nat
verify REPEATED = exists n => pair(n, n) : pair
verify EMPTY = exists n => n : empty

# expect-status: 1
# expect-output: verify SUCCESSOR PASS
# expect-output: verify REPEATED PASS
# expect-output: verify EMPTY FAIL
