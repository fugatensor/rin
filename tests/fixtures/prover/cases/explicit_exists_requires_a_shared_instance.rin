
Alice : human
Bob : mortal
all x:ghost =>
    x : mortal
all x:human =>
    mortal(x) -> human_mortal(x)
all x:ghost =>
    mortal(x) -> ghost_mortal(x)
verify DIFFERENT_OBJECTS = exists x => human_mortal(x)
verify EMPTY_DOMAIN = exists x => ghost_mortal(x)
verify UNKNOWN = exists x => unknown(x)
verify SAME_TYPE = exists x => mortal(x)

