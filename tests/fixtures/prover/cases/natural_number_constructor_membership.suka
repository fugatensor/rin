
type nat = 0 | succ(nat)
verify ZERO = 0 : nat
verify SUCCESSOR = succ(0) : nat
verify NESTED = succ(succ(0)) : nat
verify UNARY = nat(succ(succ(succ(0))))
verify UNKNOWN_CONSTRUCTOR = foo : nat
verify WRONG_ARGUMENT = succ(foo) : nat
verify WRONG_ARITY = succ(0, 0) : nat
verify WRONG_CONSTRUCTOR = next(0) : nat

# expect-status: 1
# expect-output: verify ZERO PASS
# expect-output: verify SUCCESSOR PASS
# expect-output: verify NESTED PASS
# expect-output: verify UNARY PASS
# expect-output: verify UNKNOWN_CONSTRUCTOR FAIL
# expect-output: verify WRONG_ARGUMENT FAIL
# expect-output: verify WRONG_ARITY FAIL
# expect-output: verify WRONG_CONSTRUCTOR FAIL
