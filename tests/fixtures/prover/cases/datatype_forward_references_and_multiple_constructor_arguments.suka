
type tree = leaf(nat) | node(tree, tree)
type nat = 0 | succ(nat)
verify TREE = node(leaf(0), leaf(succ(0))) : tree
verify INVALID_LEAF = leaf(foo) : tree
verify WRONG_TYPE = leaf(leaf(0)) : tree
verify WRONG_ARITY = node(leaf(0)) : tree
verify WRONG_CONSTRUCTOR = 0 : tree
verify NOT_NAT = leaf(0) : nat

# expect-status: 1
# expect-output: verify TREE PASS
# expect-output: verify INVALID_LEAF FAIL
# expect-output: verify WRONG_TYPE FAIL
# expect-output: verify WRONG_ARITY FAIL
# expect-output: verify WRONG_CONSTRUCTOR FAIL
# expect-output: verify NOT_NAT FAIL
