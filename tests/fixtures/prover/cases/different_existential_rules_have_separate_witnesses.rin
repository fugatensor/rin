
Alice : human
all x:human =>
    exists m => maternal(m)
    exists m => paternal(m)
verify MATERNAL = exists m => maternal(m)
verify PATERNAL = exists m => paternal(m)
all x:maternal =>
    paternal(x) -> shared(x)
verify SHARED = exists x => shared(x)

# expect-status: 1
# expect-output: verify MATERNAL PASS
# expect-output: verify PATERNAL PASS
# expect-output: verify SHARED FAIL
