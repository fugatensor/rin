# expect-output: verify NEG_ORDER PASS
# expect-output: verify NEG_DEC PASS
# expect-output: verify CROSS_SIGN PASS
# expect-output: verify ZERO_EQ PASS
# expect-output: verify ONE_EQ PASS
# expect-output: verify SCI PASS
# expect-output: verify INT64_FRAC PASS
# expect-output: verify UINT64_MAX PASS
# expect-output: verify DIFF_ZERO FAIL
# expect-output: verify DIFF_DEC FAIL
# expect-output: verify DIFF_ONE FAIL
# expect-output: verify NON_NUM_FAIL FAIL
