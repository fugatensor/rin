
Alice : human
Bob : mortal
all x:ghost =>
    x : mortal
verify DIFFERENT_OBJECTS = exists human -> mortal
verify EMPTY_DOMAIN = exists ghost -> mortal
verify UNKNOWN = exists unknown -> unknown
verify SAME_TYPE = exists mortal -> mortal

